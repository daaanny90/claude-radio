<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- User launchd agent: the session launcher (worktree, tmux, Claude Code). Installed by install-mac.sh -->
<plist version="1.0">
<dict>
    <key>Label</key><string>radio.launcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON3__</string>
        <string>__RADIO_DIR__/launcher.py</string>
    </array>
    <key>WorkingDirectory</key><string>__RADIO_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>__PATH__</string>
        <key>RADIO_BOT_URL</key><string>http://127.0.0.1:8790</string>
        <key>HOME</key><string>__HOME__</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>StandardOutPath</key><string>__RADIO_DIR__/logs/launcher.log</string>
    <key>StandardErrorPath</key><string>__RADIO_DIR__/logs/launcher.log</string>
</dict>
</plist>
