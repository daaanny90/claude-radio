# Copy this file to .env and fill it in.

# Tailscale IP of the Mac (find it with: tailscale ip -4). Without it, Mumble stays on localhost
TAILSCALE_IP=100.x.y.z

# Password you enter in Mumla to join the server
MUMBLE_SERVER_PASSWORD=change-me

# Mumble server admin password (rarely needed)
MUMBLE_SUPERUSER_PASSWORD=change-me-too

# Milliseconds of silence after which a phrase is considered finished
SILENCE_MS=700

# Transmissions shorter than this are "blips" (noise) and are not repeated back
MIN_UTTERANCE_MS=300

# Every how many minutes the bot plays a double beep to check that audio arrives (0 = never)
HEARTBEAT_MIN=20

# A transmission longer than this (seconds) is closed and transcribed anyway
MAX_UTTERANCE_S=60

# --- Step 4: feedback while Claude works ------------------------------------
# After transcription the bot confirms what it understood: echo = repeats the phrase ("Got it: ..."),
# short = just "Got it.", name = only who it went to ("To charlie.", nothing with a single session),
# beep = no voice
ACK_MODE=name
# With echo, the maximum number of words it repeats
ACK_MAX_WORDS=30
# Every how many seconds a discreet tick while a session works (0 = off)
TICK_S=15
# After how many seconds of silence a phrase about what it is doing ("still working, step 7, editing media viewer"; 0 = off)
PROGRESS_S=45
# Bot announcement at every change of activity (file written, command, delegation), at most one every this many seconds. Off (0): Claude announces the significant milestones, the bot talked too much
PROGRESS_CHANGE_S=0
# Spoken warning if the microphone stays open without pauses for more than this many seconds (0 = off)
MIC_OPEN_WARN_S=90
# ...and repeats it every this many seconds while it stays open: meanwhile other phrases wait
MIC_OPEN_REPEAT_S=120

# Model of the radio sessions (opus, sonnet, or a full id); empty = Claude Code's default
RADIO_MODEL=opus
# Effort of the radio sessions (low, medium, high, xhigh, max); empty = effortLevel from ~/.claude/settings.json
RADIO_EFFORT=max

# Project folders: a session opened without a registered project starts in the lobby, finds the folder below
# and moves there. Separated by colons
PROJECT_ROOTS=~/code:~/projects

# --- Board: texts, code, diffs and screenshots that the sessions show you on the phone ---
# Page at http://<TAILSCALE_IP>:BOARD_PORT, tailnet only. The first time, say "board code" to the radio
# and type the six digits. Items live in board/, the latest BOARD_KEEP are kept
BOARD_PORT=8791
BOARD_KEEP=100
# The board is also a text console: type to the sessions, answer the radio's questions, stop or close a session,
# switch the radio to silent (everything written, nothing spoken). A paired browser then controls agents that run
# commands on this machine: 0 makes the board read-only. CHAT_KEEP: messages of the conversation kept in memory
BOARD_WRITE=1
CHAT_KEEP=400

# --- Step 2: ears and mouth -------------------------------------------------
# No trailing comments on lines with a value: for docker compose " #" ends the value.

# Whisper always runs a 30 s window through the encoder, even for a "yes": on a slow CPU
# small costs about 15 s per phrase, base about 4 s. Two instances: the accurate model for
# long phrases, the fast one for short ones (commands, yes/no). Files in models/whisper.
# English radio: Whisper understands better and the Piper voices are better. For Italian:
# ggml-small-q8_0.bin, ggml-base-q8_0.bin, WHISPER_LANGUAGE=it, PIPER_VOICE=it_IT-paola-medium, REPLY_PREFIX=Ho sentito:
# On the Mac (Metal): large-v3-turbo takes about 1.1 s per phrase like small.en and understands much better (measured).
# On a CPU-only machine (whisper in Docker): ggml-small.en-q8_0.bin and, as the fast one, ggml-base.en-q8_0.bin
WHISPER_MODEL=ggml-large-v3-turbo-q8_0.bin
WHISPER_FAST_MODEL=ggml-base.en-q8_0.bin
# Phrases up to this duration (ms) go to the fast model
WHISPER_FAST_MAX_MS=2500
# Encoder window: 0 = whole (30 s). 512 cuts it to 10 s and triples the speed,
# but quality collapses (measured): leave 0
WHISPER_AUDIO_CTX=0
WHISPER_LANGUAGE=en
# Whisper threads (on the Mac with Metal they matter little; 4 on a CPU-only machine)
WHISPER_THREADS=6
# On the Mac whisper-server runs natively (whisper-mac.sh) and the bot finds it here; leave the fast one empty.
# With whisper in Docker (profile whisper-docker, Linux): http://whisper:8080/inference and http://whisper-fast:8080/inference
WHISPER_URL=http://host.docker.internal:8781/inference
WHISPER_FAST_URL=
# Extra options for the native whisper-server (flash attention on Metal is already on)
WHISPER_EXTRA=
# 1 = greedy (fast), 5 = beam search (more accurate, slower)
WHISPER_BEAM_SIZE=1
# Vocabulary hint for Whisper: names it would otherwise get wrong
WHISPER_PROMPT=Claude Code, Storybook, worktree, branch, merge request, pull request, ticket, component, frontend, pnpm, Alpha, Bravo, Charlie, Delta, Echo, Foxtrot, Golf, Hotel, Operator. Status, repeat, quiet, close, open, board code, who. Stop, all stop, break break.

# Piper voice (.onnx file in models/piper): en_US-lessac-medium, en_US-hfc_female-medium,
# en_GB-alan-medium; Italian: it_IT-paola-medium, it_IT-serena-high (slow)
PIPER_VOICE=en_US-lessac-medium
# Speech speed: 1.0 normal, 1.2 is 20% slower
PIPER_LENGTH_SCALE=1.2
# Sounds. SOUND_THEME: classic (the original beeps), blade, cyber, radio, walkie, mission, objects, neon,
# cinema, booth (see bot/sounds.py and the sampler on the board). VOICE_FX: filter on the voices
# (empty, light, medium, strong). BED: background while they work (hall = distant beeps instead of
# ticks; channel = a hiss like an open radio channel; breath = an occasional soft breath; empty = ticks).
# BED_LEVEL: background volume. AGENT_SIGNATURES: sound signature of each session before its
# messages (1 = yes).
# The old Italian names (classico, ricetrasmittente, missione, oggetti, cabina; leggero, medio, forte;
# sala, canale, respiro) still work as aliases.
SOUND_THEME=cinema
VOICE_FX=medium
BED=hall
BED_LEVEL=0.05
AGENT_SIGNATURES=0
# One voice per session, to tell them apart by ear (empty = all use PIPER_VOICE). The bot keeps PIPER_VOICE
AGENT_VOICES=alpha=en_US-lessac-medium,bravo=en_US-hfc_female-medium,charlie=en_GB-alan-medium,delta=en_GB-jenny_dioco-medium,echo=en_GB-northern_english_male-medium,foxtrot=en_GB-cori-medium,golf=en_GB-aru-medium,operator=en_US-ryan-high
# What the bot says before repeating the transcribed phrase
REPLY_PREFIX=I heard:
# Silence before each reply, in ms: gives Bluetooth headphones time to wake up
REPLY_PREROLL_MS=1500
# Seconds of audio per Mumble packet (0.02 standard; 0.04 = half the packets, more robust to jitter)
AUDIO_PER_PACKET=0.02
# Diagnostics: ECHO=1 repeats your voice instead of transcribing, ECHO_DELAY_S delays it
ECHO=0
ECHO_DELAY_S=0

# Time zone of the bot's log timestamps (default UTC)
TZ=UTC
