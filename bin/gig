#!/usr/bin/env python3
"""
gig: one Claude Code agent per ticket, each in its own git worktree, in a tmux window or a Herdr space
(https://herdr.dev). bin/roger, its old name, is a link to it: the Herdr mods call that one.

  gig open KEY [-p PROJECT] [--task TEXT] [--dry-run]
  gig close KEY|FOLDER [-p PROJECT] [--force] [--dry-run]
  gig init [--yes]

KEY is a ticket key (SHOP-1234), one of its branches in full, or a link with one in it. The ticket's branch is the
one it already has, locally or on origin, else a new KEY-<slug of its summary>: a subtask's starts from its
parent's branch (a local one from origin/<base_branch> when the parent has none yet), the others from
origin/<base_branch>. Its worktree is the one git already has for it, else a new
<dir>--<branch> next to the project's checkout with the git-ignored files of "copy" and pnpm install, as the
launcher makes them. Then claude starts on the worktree with the first message (tasks.work, or the project's
ticket_request): inside tmux in a new window of the current session, marked with @roger_worktree, else in a Herdr
space. A ticket whose window or space is open already gets it shown.

--task gives the agent another first message, for work on the branch that isn't the ticket's own (reviewing a
merge request, answering one's review). With a branch or a link the project must come from -p or the current
folder, as the caller knows the repository; a bare key goes by its prefix. A window or space open already on the
worktree gets a new window or tab beside it with that agent.

close deletes what open made: the tmux windows and Herdr spaces on the worktree (one whose panes or terminals all
moved elsewhere with cd stays open, one half in and half out stops close), the processes left running in it, the
worktree and the local branch (never a shared one or the base; the remote one never). With work that would be lost
it closes nothing, --force closes anyway; a shell or an editor still in the worktree keeps it. FOLDER, a worktree's
folder, closes exactly that one, detached or on a branch of no ticket too (what herdr/roger, the Herdr mod, passes).

Settings come from the client's gig.json, the nearest one above the current folder (above FOLDER for close FOLDER,
wherever it runs), which gig init writes asking
step by step: the ticket tracker with ticket_info, a command that prints a ticket as JSON ({"summary", "subtask",
"parent"}, parent for subtasks only), the code host, the scripts and claude commands the projects share, agent_args
(flags for claude), the first messages (tasks) and the projects. Paths in it are relative to its folder. Without one,
projects.json (the radio's) as before. When the folder above the client's is a Claude Code plugin marketplace
(.claude-plugin/marketplace.json), init also makes the client's plugin (_claude-plugin, listed there by the client's
folder name) and enables it in the projects with local scope; gig's picker offers its skills as /<plugin>:<skill>.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import unicodedata

RADIO_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
PROJECTS_FILE = os.getenv("PROJECTS_FILE") or os.path.join(RADIO_DIR, "projects.json")   # another one for tests
CONFIG_NAME = "gig.json"   # a client's settings, in the client's folder: gig init writes it
PLUGIN_DIR = "_claude-plugin"   # the client's Claude Code plugin, in the client's folder: its skills are /<plugin>:<skill>
KEY = re.compile(r"[A-Za-z][A-Za-z0-9]*-\d+")
# A process with one of these names in the worktree may be a terminal of yours: close leaves the worktree alone
INTERACTIVE = {"zsh", "bash", "sh", "fish", "nvim", "vim", "vi", "nano", "emacs"}
# Branches that outlive every ticket: close deletes the folder, never these (as launcher.py)
SHARED_BRANCHES = {"main", "master", "develop", "sprint"}
ASK = False   # a person at a terminal: questions become pickers, open and close get colours (main sets it)
# fzf as a small dialog: the first tab-separated field is the value, the rest is what shows
FZF = ["fzf", "--style", "full", "--layout", "reverse", "--ansi", "--delimiter", "\t", "--with-nth", "2..",
       "--info", "inline-right", "--pointer", "▌"]


class Stop(Exception):
    """Why roger stops, for the person: printed without a traceback."""


def run(cmd, timeout=120, env=None):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)


def git(path, *args, timeout=120, env=None):
    return run(["git", "-C", path, *args], timeout=timeout, env=env)


def tail(text, n=3):
    return " ".join((text or "").strip().splitlines()[-n:])[:300]


def has_ref(main, ref):
    return git(main, "rev-parse", "--verify", "--quiet", ref).returncode == 0


def worktree_of(main, branch):
    """Where git has the branch checked out (the main checkout or a worktree), or None."""
    r = git(main, "worktree", "list", "--porcelain")
    for block in r.stdout.split("\n\n"):
        path, checked_out = re.search(r"^worktree (.+)$", block, re.M), re.search(r"^branch refs/heads/(.+)$", block, re.M)
        if path and checked_out and checked_out.group(1) == branch:
            return os.path.realpath(path.group(1))
    return None


def slug(text):
    """A summary as the tracker's "create branch" turns it into a branch name (checked against existing branches):
    ä -> a, ß -> ss, camelCase split (ShopTile -> shop-tile, even TODOs -> tod-os), underscores kept, no length limit."""
    text = text.replace("ß", "ss").replace("ẞ", "SS")
    text = "".join(c for c in unicodedata.normalize("NFKD", text) if not unicodedata.combining(c))
    text = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1-\2", text)
    text = re.sub(r"([a-z0-9])([A-Z])", r"\1-\2", text).lower()
    return re.sub(r"-{2,}", "-", re.sub(r"[^a-z0-9_-]+", "-", text)).strip("-")


def branch_name(key, summary):
    words = slug(summary or "")
    return f"{key}-{words}" if words else key


def client_dir(start=None):
    """The client's folder: the nearest one above start (the current folder) with a gig.json."""
    d = os.path.realpath(start or os.getcwd())
    while not os.path.isfile(os.path.join(d, CONFIG_NAME)):
        if d == os.path.dirname(d):
            return None
        d = os.path.dirname(d)
    return d


def load_config(start=None):
    """The client's gig.json, the nearest one above start (the current folder), else projects.json (the radio's, where
    the settings were before; PROJECTS_FILE, set for tests, wins). Paths in gig.json are relative to the client's folder."""
    client = None if os.getenv("PROJECTS_FILE") else client_dir(start)
    path = os.path.join(client, CONFIG_NAME) if client else PROJECTS_FILE
    try:
        with open(path, encoding="utf-8") as f:
            config = json.load(f)
    except (OSError, ValueError) as e:
        raise Stop(f"cannot read {path}: {e}")
    config["_file"] = path
    if client:
        here = lambda p: p and os.path.join(client, os.path.expanduser(p))
        config["ticket_info"] = here((config.get("tracker") or {}).get("ticket_info"))
        config["projects"] = [dict(p, dir=here(p["dir"])) for p in config.get("projects") or []]
    return config


def find_project(config, key, name=None, strict=False):
    """By name or alias; else the project whose checkout, or a worktree of it, holds the current folder, when the
    key's prefix is its own or no project's; else the only one with the key's prefix. A prefix can belong to several
    projects, and a ticket can span them: in another project's folder, the person chooses. Strict, the folder must
    be one: a caller that knows the repository (a merge request's) must not get another one by prefix."""
    projects = config.get("projects") or []
    if not projects:
        raise Stop(f"no projects in {config['_file']}: add the client's repositories there")
    if name:
        for p in projects:
            names = [p["name"], p.get("say") or "", *(p.get("aliases") or [])]
            if name.lower() in (n.lower() for n in names):
                return p
        raise Stop(f"no project called {name!r}: " + ", ".join(p["name"] for p in projects))
    prefix = key.rsplit("-", 1)[0]
    same = [p for p in projects if (p.get("ticket_prefix") or "").upper() == prefix]
    r = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"])
    if r.returncode == 0:
        main = os.path.dirname(os.path.realpath(r.stdout.strip()))
        here = next((p for p in projects if os.path.realpath(os.path.expanduser(p["dir"])) == main), None)
        if here and (strict or not same or here in same):
            return here
        if here:   # parsed by herdr/roger/main.js
            return choose_project([*same, here])
    if strict:
        raise Stop(f"{os.getcwd()} is not in a project's checkout: add it to projects.json, or pass -p")
    if len(same) == 1 or len(projects) == 1:
        return (same or projects)[0]
    return choose_project(same or projects)


def choose_or_stop(question, options, message):
    """A person at a terminal picks; a caller without one (a Herdr mod, claude) gets the message, which it parses."""
    if not ASK:
        raise Stop(message)
    code, out = fzf([f"{o}\t{o}" for o in options], "--border-label", " gig ", "--input-label", f" {question} ")
    if code != 0 or not out:
        raise SystemExit(130)
    return out[0].split("\t", 1)[0]


def choose_project(projects):   # the message is parsed by herdr/roger/main.js
    names = [p["name"] for p in projects]
    name = choose_or_stop("which project?", names, "which project? -p " + " | ".join(names))
    return next(p for p in projects if p["name"] == name)


def ticket(config, key):
    cmd = config.get("ticket_info")
    if not cmd:
        raise Stop(f"no ticket_info command in {config['_file']}")
    r = run([*shlex.split(os.path.expanduser(cmd)), key], timeout=60)
    if r.returncode != 0:
        raise Stop(f"{key}: " + tail(r.stderr or r.stdout))
    return json.loads(r.stdout)


def branches(main, key, refs):
    """The ticket's branch names under refs (refs/heads or refs/remotes/origin): KEY or KEY-..., so KEY-1 never
    picks up KEY-12."""
    out = git(main, "for-each-ref", "--format=%(refname)", refs).stdout.split()
    names = {ref[len(refs) + 1:] for ref in out}
    return {n for n in names if n == key or n.startswith(key + "-")}


def pick(names, wanted, key):
    """The branch to use: the summary's name, else the only one there is (an old one such as KEY-alpha), else None.
    Several and none of them the summary's: the person chooses."""
    if wanted in names:
        return wanted
    if len(names) > 1:   # parsed by herdr/roger/main.js
        return choose_or_stop(f"which branch of {key}?", sorted(names),
                              f"{key} has several branches, name the one to open: " + ", ".join(sorted(names)))
    return next(iter(names), None)


def base_of(config, main, project, info, dry_run=False):
    """Where a new branch starts: a subtask from its parent's branch, origin's or else a local one (the story is
    the subtask's merge target), the rest from origin/<base_branch>. A parent with no branch yet gets a local one
    from origin/<base_branch>, without a worktree, and the person pushes it."""
    base = "origin/" + (project.get("base_branch") or "master")
    if not (info.get("subtask") and info.get("parent")):
        return base
    parent = info["parent"]
    wanted = branch_name(parent, ticket(config, parent).get("summary"))
    found = pick(branches(main, parent, "refs/remotes/origin"), wanted, parent)
    if found:
        return f"origin/{found}"
    found = pick(branches(main, parent, "refs/heads"), wanted, parent)
    if found:
        return found
    print(f"parent branch: {wanted} (new, from {base}; not on origin yet: push it before the merge request)")
    if not dry_run:
        r = git(main, "branch", "--no-track", wanted, base)
        if r.returncode != 0:
            raise Stop(f"git branch {wanted} failed: " + tail(r.stderr))
    return wanted


def herdr(*args):
    r = run(["herdr-app", *args], timeout=30)
    try:
        out = json.loads(r.stdout or "{}")
    except ValueError:
        out = {}
    if r.returncode != 0 or "error" in out:
        raise Stop(f"herdr-app {' '.join(args[:2])}: " + str(out.get("error") or tail(r.stderr or r.stdout)))
    return out


def space_on(folder):
    for space in herdr("ls").get("spaces", []):
        if space.get("folder") and os.path.realpath(space["folder"]) == folder:
            return space
    return None


def tmux(*args, dry_run=False):
    if dry_run:
        print("  " + shlex.join(["tmux", *args]))
        return "@new"
    r = run(["tmux", *args], timeout=30)
    if r.returncode != 0:
        raise Stop(f"tmux {args[0]}: " + tail(r.stderr or r.stdout))
    return r.stdout.strip()


def windows_on(folder):
    """The tmux windows roger opened on folder, as (session id, window id, session:window name): they carry it in
    @roger_worktree."""
    found = []
    fmt = "#{session_id}\t#{window_id}\t#{session_name}:#{window_name}\t#{@roger_worktree}"
    for line in tmux("list-windows", "-a", "-F", fmt).splitlines():
        session, window, label, *path = line.split("\t")   # strip() takes the last line's tab when its path is empty
        path = "".join(path)
        if path and inside(os.path.realpath(path), folder):
            found.append((session, window, label))
    return found


def open_tmux(args, key, worktree, argv, task):
    """Inside tmux the ticket gets a window in the session roger runs from, with claude in the worktree; claude
    takes the first message as an argument. The window carries the worktree in @roger_worktree, for open and close."""
    agent = shlex.join([*argv, task] if task else argv)   # no task: resume (argv has --continue)
    found = [] if args.dry_run and not os.path.isdir(worktree) else windows_on(worktree)
    if found and not args.task:
        session, window, label = found[0]
        print(f"tmux: window {label} is open already, shown")
        tmux("select-window", "-t", window, dry_run=args.dry_run)
        tmux("switch-client", "-t", session, dry_run=args.dry_run)
        return
    # the ticket's own agent stays as it is: other work gets a window beside it
    # a popup (C-a T) has no pane: tmux finds the client the popup is on by itself
    here = ["-t", os.environ["TMUX_PANE"]] if os.getenv("TMUX_PANE") else []
    session = tmux("display-message", "-p", *here, "#{session_id}")
    name = f"{key}-{args.task.split()[0].lstrip('/')}" if args.task else key
    first = task.strip().splitlines()[0] + (" …" if "\n" in task.strip() else "") if task else ""
    print(f"tmux: new window {name}" + (" beside the open one" if found else "")
          + (f"\n  first message: {first}" if task else "\n  its last conversation again"))
    window = tmux("new-window", "-P", "-F", "#{window_id}", "-t", f"{session}:", "-c", worktree, "-n", name, agent,
                  dry_run=args.dry_run)
    tmux("set-option", "-w", "-t", window, "@roger_worktree", worktree, dry_run=args.dry_run)


def copy_ignored(main, worktree, items):
    """Git-ignored files that a worktree does not bring along (CLAUDE.md, .claude, ...). Symlinks stay symlinks:
    .claude/commands links into a shared folder by relative paths, right only from next to the checkout.
    .claude/worktrees stays behind: Claude's own worktrees of the checkout, whole copies with their git-ignored
    files, secrets too, that would multiply with every new worktree."""
    claude_worktrees = lambda folder, names: ["worktrees"] if folder == os.path.join(main, ".claude") else []
    for item in items:
        src, dst = os.path.join(main, item), os.path.join(worktree, item)
        if os.path.isdir(src) and not os.path.islink(src):
            shutil.copytree(src, dst, symlinks=True, dirs_exist_ok=True, ignore=claude_worktrees)
        elif os.path.exists(src) or os.path.islink(src):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst, follow_symlinks=False)


def parse_key(text):
    """The key at the start (SHOP-12, or a branch such as SHOP-12-fix-after-shop-34), else the first one (a link)."""
    found = KEY.match(text) or KEY.search(text)
    if not found:
        raise Stop(f"no ticket key in {text!r}")
    return found.group(0).upper()


def open_ticket(args):
    config = load_config()
    key = parse_key(args.ticket)
    # strict for a merge request's branch, whose repository the caller knows: a bare key with a task goes by prefix
    project = find_project(config, key, args.project, strict=bool(args.task) and not KEY.fullmatch(args.ticket))
    main = os.path.realpath(os.path.expanduser(project["dir"]))
    if not os.path.isdir(main):
        raise Stop(f"project folder not found: {main}")
    info = ticket(config, key)
    print(f"{key}: {info.get('summary')} ({info.get('type')}" + (f", subtask of {info['parent']})" if info.get("parent") else ")"))
    print(f"project: {project['name']} ({main})")

    try:   # no prompts: a VPN that is off makes the fetch hang, not fail
        r = git(main, "fetch", "origin", timeout=60, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
    except subprocess.TimeoutExpired:
        raise Stop("git fetch timed out (VPN off?)")
    if r.returncode != 0:
        raise Stop("git fetch failed (VPN off?): " + tail(r.stderr))

    wanted = branch_name(key, info.get("summary"))
    names = branches(main, key, "refs/heads") | branches(main, key, "refs/remotes/origin")
    branch = args.ticket if args.ticket in names else pick(names, wanted, key)   # a branch named in full wins
    base = None if branch else base_of(config, main, project, info, args.dry_run)
    branch = branch or wanted
    local, remote = has_ref(main, f"refs/heads/{branch}"), has_ref(main, f"refs/remotes/origin/{branch}")
    print(f"branch: {branch} (" + (f"new, from {base}" if base else "local" if local else "from origin") + ")")

    if not args.dry_run:
        git(main, "worktree", "prune")   # a worktree deleted by hand no longer holds its branch
    worktree = worktree_of(main, branch)
    if worktree == main:
        raise Stop(f"{branch} is checked out in the main folder {main}: switch it there first")
    if local and remote:   # someone pushed, or a review on yesterday's copy: catch up when nothing local is lost
        behind = git(main, "rev-list", "--count", f"{branch}..origin/{branch}").stdout.strip()
        ahead = git(main, "rev-list", "--count", f"origin/{branch}..{branch}").stdout.strip()
        if behind not in ("", "0") and ahead == "0" and not worktree:
            print(f"local {branch} is {behind} commits behind origin: fast-forwarded")
            if not args.dry_run:
                git(main, "branch", "-f", branch, f"origin/{branch}")
        elif behind not in ("", "0"):
            print(f"note: {branch} is {behind} commits behind origin")

    copy, install = project.get("copy") or [], project.get("install") is not False   # null in gig.json: the default
    if worktree:
        changes = len(git(worktree, "status", "--porcelain").stdout.splitlines())
        print(f"worktree: {worktree} (resumed" + (f", {changes} uncommitted changes)" if changes else ")"))
    else:
        worktree = f"{main}--{branch.replace('/', '-')}"
        print(f"worktree: {worktree} (new; copy {', '.join(copy) or 'nothing'}"
              + ("; pnpm install)" if install else ")"))
        if not args.dry_run:
            if local:
                cmd = ["worktree", "add", worktree, branch]
            elif remote:
                cmd = ["worktree", "add", "--track", "-b", branch, worktree, f"origin/{branch}"]
            else:   # --no-track: a new branch must not take origin/master as its upstream
                cmd = ["worktree", "add", "--no-track", "-b", branch, worktree, base]
            r = git(main, *cmd)
            if r.returncode != 0:
                raise Stop("git worktree failed: " + tail(r.stderr))
            copy_ignored(main, worktree, copy)
            if install and os.path.exists(os.path.join(worktree, "pnpm-lock.yaml")):
                print("pnpm install ...", flush=True)
                r = run(["bash", "-lc", f"cd {shlex.quote(worktree)} && pnpm install --frozen-lockfile --prefer-offline"],
                        timeout=900)
                if r.returncode != 0:
                    print("note: dependencies not installed: " + tail(r.stderr or r.stdout))

    # With ANTHROPIC_API_KEY in the environment claude bills the API instead of the subscription (session.sh unsets it too)
    argv = ["env", "-u", "ANTHROPIC_API_KEY", "claude", *(config.get("agent_args") or [])]
    work = (config.get("tasks") or {}).get("work")   # gig.json's; a project's own ticket_request wins
    if args.task:
        task = args.task
    elif work and not project.get("ticket_request"):
        task = work.replace("{key}", key)
    else:
        task = " ".join(filter(None, [f"Ticket {key}.", project.get("ticket_request")]))
    if os.getenv("TMUX"):   # the Herdr mod runs roger outside tmux, so it keeps its spaces
        return open_tmux(args, key, worktree, argv, task)
    space = None if args.dry_run and not os.path.isdir(worktree) else space_on(worktree)
    if space and args.task:   # the ticket's own agent stays as it is: the other work gets a tab beside it
        name = args.task.split()[0].lstrip("/")
        print(f"herdr: space {space.get('name')} is open already: new tab {name}: {shlex.join(argv)}\n  first message: {task}")
        if not args.dry_run:
            herdr("do", "space.select", json.dumps({"id": space["id"]}))
            ids = herdr("do", "tab.new", json.dumps({"name": name, "space": space["id"], "folder": worktree, "argv": argv, "task": task}))
            print(f"herdr: opened, tab {ids.get('tab')}, terminal {ids.get('terminal')}")
        return
    if space:
        print(f"herdr: space {space.get('name')} is open already, shown")
        if not args.dry_run:
            herdr("do", "space.select", json.dumps({"id": space["id"]}))
        return
    print(f"herdr: new space {key}: {shlex.join(argv)}\n  first message: {task}")
    if not args.dry_run:
        ids = herdr("do", "space.new", json.dumps({"name": key, "folder": worktree, "argv": argv, "task": task}))
        print(f"herdr: opened, space {ids.get('space')}, terminal {ids.get('terminal')}")


def inside(path, folder):
    """path is folder or below it. A plain prefix test would take ui--SHOP-1-a-b for a part of ui--SHOP-1-a."""
    return path == folder or path.startswith(folder + os.sep)


def git_out(path, *args):
    r = git(path, *args)
    return r.stdout.strip() if r.returncode == 0 else None


def work_at_risk(worktree):
    """What deleting the worktree would lose, in words ("" for nothing): uncommitted changes, untracked files too, and
    commits on no other branch, remote or tag. A pushed branch, or one with nothing new on it, loses nothing."""
    changes = len((git_out(worktree, "status", "--porcelain") or "").splitlines())
    branch = git_out(worktree, "symbolic-ref", "--short", "-q", "HEAD")   # None: detached
    others = ([f"--exclude={branch}"] if branch else []) + ["--branches", "--remotes", "--tags"]
    commits = int(git_out(worktree, "rev-list", "--count", "HEAD", "--not", *others) or 0)
    lost = ([f"{changes} uncommitted {'file' if changes == 1 else 'files'}"] if changes else []) + \
           ([f"{commits} unpushed {'commit' if commits == 1 else 'commits'}"] if commits else [])
    return " and ".join(lost)


def ticket_worktrees(main, key):
    """The linked worktrees with a branch of the ticket checked out: [(folder, branch)]; with no key every one, a
    detached one with branch None. Never the main checkout."""
    found = []
    for block in git(main, "worktree", "list", "--porcelain").stdout.split("\n\n"):
        path, checked_out = re.search(r"^worktree (.+)$", block, re.M), re.search(r"^branch refs/heads/(.+)$", block, re.M)
        branch = checked_out.group(1) if checked_out else None
        if path and (key is None or branch and (branch == key or branch.startswith(key + "-"))):
            folder = os.path.realpath(path.group(1))
            if folder != main:
                found.append((folder, branch))
    return found


def processes_in(folder):
    """[(pid, name)] of your processes whose current folder is in folder."""
    out = run(["lsof", "-w", "+c", "0", "-d", "cwd", "-F", "pcn"], timeout=60).stdout
    found, pid, name = [], None, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("c"):
            name = line[1:].lstrip("-")   # -zsh: a login shell
        elif line.startswith("n") and inside(os.path.realpath(line[1:]), folder):
            found.append((pid, name))
    return found


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def end(processes):
    """TERM, then KILL whatever is left after five seconds."""
    for pid, _ in processes:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    left, deadline = [pid for pid, _ in processes], time.time() + 5
    while left and time.time() < deadline:
        time.sleep(0.2)
        left = [pid for pid in left if alive(pid)]
    for pid in left:
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass


def live_folder(terminal):
    """Where a terminal's shell is now. Herdr and hc keep the folder it started in, and a cd leaves that behind."""
    try:
        info = json.loads(run(["hc", "get", terminal, "--json"], timeout=30).stdout)
    except ValueError:
        return None
    if info.get("pid"):
        out = run(["lsof", "-w", "-a", "-p", str(info["pid"]), "-d", "cwd", "-Fn"], timeout=30).stdout
        now = next((line[1:] for line in out.splitlines() if line.startswith("n")), None)
        if now:
            return os.path.realpath(now)
    return os.path.realpath(info["cwd"]) if info.get("cwd") else None


def own_space():
    """The Herdr space of the terminal roger runs in, if any: closing that one would stop roger halfway."""
    terminal = os.getenv("HC_TERMINAL_ID")
    if not terminal:
        return None
    try:
        return json.loads(run(["hc", "get", terminal, "--json"], timeout=30).stdout).get("labels", {}).get("herdr.space")
    except ValueError:
        return None


def close_ticket(args):
    folder = os.path.expanduser(args.ticket)
    folder = os.path.realpath(folder) if os.path.isdir(folder) else None
    config = load_config(folder)   # a folder's own client, wherever close runs (the Herdr mod runs it from home)
    # a worktree's folder is exactly that one, whatever its name says (shop--alpha) and its branch, if any
    key = None if folder else parse_key(args.ticket)
    projects = config.get("projects") or []
    if args.project:
        candidates = [find_project(config, key, args.project)]
    elif folder:   # its repository, whatever the prefix: an agent may add a worktree of its ticket in another project
        common = git_out(folder, "rev-parse", "--path-format=absolute", "--git-common-dir")
        main = os.path.dirname(os.path.realpath(common)) if common else None
        candidates = [p for p in projects if os.path.realpath(os.path.expanduser(p["dir"])) == main] or projects
    else:   # the worktree tells the project, wherever close runs from: a prefix can belong to several
        prefix = key.rsplit("-", 1)[0]
        candidates = [p for p in projects if (p.get("ticket_prefix") or "").upper() == prefix] or projects
    found = []
    for project in candidates:
        main = os.path.realpath(os.path.expanduser(project["dir"]))
        if os.path.isdir(main):
            if not args.dry_run:
                git(main, "worktree", "prune")   # a worktree deleted by hand no longer holds its branch
            found += [(project, main, folder, branch) for folder, branch in ticket_worktrees(main, key)]
    if folder:
        found = [f for f in found if f[2] == folder]
    else:
        found = [f for f in found if f[3] == args.ticket] or found   # a branch named in full
    if not found:
        raise Stop(f"{folder} is no worktree of a project" if folder else f"{key} has no worktree")
    if len(found) > 1:
        raise Stop(f"{key} has several worktrees, name the branch or the project (-p): "
                   + ", ".join(f"{f[3]} ({f[0]['name']})" for f in found))
    project, main, worktree, branch = found[0]
    print(f"worktree: {worktree} ({branch or 'detached'})")
    if inside(os.path.realpath(os.getcwd()), worktree):
        raise Stop("you are inside the worktree: run close from another folder")
    # A space keeps the folder it was opened in: one opened from the worktree and moved elsewhere with cd is other work
    try:
        listed = herdr("ls").get("spaces", [])
    except (Stop, OSError, subprocess.TimeoutExpired):   # Herdr is not running: tmux windows only
        listed = []
    spaces = []
    for space in listed:
        if not (space.get("folder") and inside(os.path.realpath(space["folder"]), worktree)):
            continue
        where = {t["terminal"]: live_folder(t["terminal"]) for tab in space.get("tabs", []) for t in tab.get("terminals", [])}
        away = {t: f for t, f in where.items() if f and not inside(f, worktree)}
        if not away:
            spaces.append(space)
        elif len(away) == len(where):
            print(f"herdr: {space.get('name') or space['id']} stays open, it works elsewhere: "
                  + ", ".join(f"{t} in {f}" for t, f in away.items()))
        else:
            raise Stop(f"space {space.get('name') or space['id']} works in the worktree and elsewhere ("
                       + ", ".join(f"{t} in {f}" for t, f in away.items()) + "): close or move those terminals first")
    if own_space() in {s["id"] for s in spaces}:
        raise Stop("this terminal is in a space of the worktree: run close from another one")
    # A window keeps the worktree roger opened it on: one whose panes all moved elsewhere with cd is other work
    try:
        tagged = windows_on(worktree)
    except (Stop, OSError):   # no tmux server, or no tmux
        tagged = []
    windows = []
    for _, window, label in tagged:
        panes = [line.partition("\t") for line in tmux("list-panes", "-t", window, "-F", "#{pane_id}\t#{pane_current_path}",
                                                       "-f", "#{?@gig_sidebar_pane,0,1}").splitlines()]   # gig's sidebar is in no worktree
        away = {p: f for p, _, f in panes if f and not inside(os.path.realpath(f), worktree)}
        if not away:
            windows.append((window, label))
        elif len(away) == len(panes):
            print(f"tmux: {label} stays open, it works elsewhere: " + ", ".join(f"{p} in {f}" for p, f in away.items()))
        else:
            raise Stop(f"window {label} works in the worktree and elsewhere ("
                       + ", ".join(f"{p} in {f}" for p, f in away.items()) + "): close or move those panes first")
    pane = os.getenv("TMUX_PANE")   # none in a popup, which outlives the window
    if pane and tmux("display-message", "-p", "-t", pane, "#{window_id}") in {w for w, _ in windows}:
        raise Stop("this terminal is in a window of the worktree: run close from another one")
    lost = work_at_risk(worktree)
    if lost and not args.force:   # a person at a terminal (the popup) says yes, and it closes as with --force
        if not ASK:
            raise Stop(f"{lost} in the worktree: closing deletes them. --force closes anyway")   # parsed by herdr/roger/main.js
        if not sure(f"{R}{lost}{O} in the worktree: closing deletes them. Close anyway?"):
            raise Stop("nothing closed")
    admin = git_out(worktree, "rev-parse", "--absolute-git-dir")
    if admin and os.path.exists(os.path.join(admin, "locked")):
        raise Stop("the worktree is locked (git worktree unlock)")
    keep = not branch or branch in SHARED_BRANCHES or branch == (project.get("base_branch") or "master")
    print("herdr: close " + (", ".join(s.get("name") or s["id"] for s in spaces) or "no space"))
    print("tmux: close " + (", ".join(label for _, label in windows) or "no window"))
    said = "branch: none, detached" if not branch else f"branch: {branch} " + ("stays (shared)" if keep else "deleted locally, origin's untouched")
    if args.dry_run:
        print(said)
        now = processes_in(worktree)
        print("processes in it now: " + (", ".join(f"{name} ({pid})" for pid, name in now) or "none")
              + (" (those of the spaces and windows end with them)" if (spaces or windows) and now else ""))
        return

    for space in spaces:
        herdr("do", "space.close", json.dumps({"id": space["id"], "confirmed": True}))
    for window, _ in windows:
        tmux("kill-window", "-t", window)
    for _ in range(10):   # the shells of the closed spaces take a moment to end
        left = processes_in(worktree)
        yours = [f"{name} ({pid})" for pid, name in left if name in INTERACTIVE]
        if not yours:
            break
        time.sleep(0.5)
    if yours:
        raise Stop("still open in the worktree, which stays: " + ", ".join(yours))
    if left:   # a Storybook or a dev server the agent left running holds a GB of memory each
        print("stopping: " + ", ".join(f"{name} ({pid})" for pid, name in left))
        end(left)
    closing = f"{worktree}.{time.strftime('%Y%m%d%H%M%S')}.closing"
    os.rename(worktree, closing)   # instant: the files go in the background, node_modules take a while
    git(main, "worktree", "prune")
    r = None if keep else git(main, "branch", "-D", branch)
    print(said if r is None or r.returncode == 0 else "branch not deleted: " + tail(r.stderr))   # once done: close can stop before
    subprocess.Popen(["rm", "-rf", closing], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"closed, {os.path.basename(worktree)} is being deleted")


# gig init: a client's gig.json, asked for step by step like a project scaffolder. What gig can tell from the
# folder, projects.json and workbench.json it proposes, and enter keeps it; without a terminal (or with --yes) the
# proposals are the answers.
C, B, D, G, R, O = ("\033[36m", "\033[1m", "\033[2m", "\033[32m", "\033[31m", "\033[0m") if sys.stdout.isatty() else ("",) * 6


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def ask(tty, question, default="", note=None):
    """A question with what gig proposes: enter keeps it, - leaves it empty."""
    if not tty:
        return default
    if note:
        print(f"  {D}{note}{O}")
    shown = (default.splitlines() or [""])[0] + (" …" if "\n" in default.strip() else "")
    try:
        answer = input(f"{C}?{O} {B}{question}{O}" + (f" {D}({shown}){O}" if shown else "") + " ").strip()
    except EOFError:
        raise Stop("init stopped, nothing written")
    return "" if answer == "-" else answer or default


def confirm(tty, question, default=True):
    answer = ask(tty, question + (" [Y/n]" if default else " [y/N]"))
    return default if not answer else answer.lower().startswith("y")


def choose(tty, question, options, default=None, multi=False):
    """fzf under the question, the proposal first: enter takes it. multi: every option comes marked, tab unmarks,
    enter takes the marked."""
    if not tty:
        return options if multi else default
    if multi:   # fzf hands over the highlighted line when none is marked: (none) is the one highlighted first
        default, options = "(none)", ["(none)", *options]
    options = ([default] if default in options else []) + [o for o in options if o != default]
    r = subprocess.run(["fzf", "--height", str(min(len(options), 12) + 3), "--layout", "reverse", "--info", "hidden",
                        "--prompt", f"? {question} › ", *(["--multi", "--header", "tab unmarks, enter takes the marked",
                                                           "--bind", "load:select-all+first+toggle",   # all but (none)
                                                           "--bind", 'enter:transform:[ "$FZF_SELECT_COUNT" = 0 ] && echo first+accept || echo accept']
                                                          if multi else [])],
                       input="\n".join(options), stdout=subprocess.PIPE, text=True)
    if r.returncode == 130:
        raise Stop("init stopped, nothing written")
    picked = [o for o in r.stdout.splitlines() if o != "(none)"]
    print(f"{G}✓{O} {B}{question}{O} {', '.join(picked) or '-'}")
    return picked if multi else (picked[0] if picked else default)


def keychain_item(tty, what, service, account):
    """Where a token lives in the Keychain: gig.json names the item, never the token. A missing one can be added."""
    item = {"service": ask(tty, f"{what}: Keychain service", service), "account": ask(tty, f"{what}: Keychain account", account)}
    if run(["security", "find-generic-password", "-s", item["service"], "-a", item["account"]]).returncode == 0:
        print(f"  {G}✓{O} {D}in the Keychain{O}")
        return item
    print(f"  {R}✗{O} {D}not in the Keychain{O}")
    if tty and confirm(tty, "add the token now? you paste it, it goes straight to the Keychain", False):
        subprocess.run(["security", "add-generic-password", "-s", item["service"], "-a", item["account"], "-w"])
    else:
        print(f"  {D}later: security add-generic-password -s {item['service']} -a {item['account']} -w{O}")
    return item


def host_of(url):
    """github.com from git@github.com:me/x.git, ssh://git@gitlab.x.de:4222/g/x.git or https://gitlab.x.de/g/x."""
    found = re.match(r"^(?:[a-z+]+://)?(?:[^@/]+@)?([^:/]+)", url or "")
    return found.group(1) if found else None


def main_checkouts(client):
    """The repositories right in the client's folder: a .git folder (a worktree has a .git file) and no -- in the name."""
    return [(name, os.path.join(client, name)) for name in sorted(os.listdir(client))
            if "--" not in name and os.path.isdir(os.path.join(client, name, ".git"))]


def init_client(args):
    client = os.path.realpath(os.getcwd())
    path = os.path.join(client, CONFIG_NAME)
    if os.path.exists(path):
        raise Stop(f"{path} exists already: edit it, or move it away to start over")
    tty = sys.stdin.isatty() and sys.stdout.isatty() and not args.yes
    old = read_json(PROJECTS_FILE)
    mine = {os.path.realpath(os.path.expanduser(p["dir"])): p for p in old.get("projects", [])
            if inside(os.path.realpath(os.path.expanduser(p["dir"])), client)}
    top = old if mine else {}   # projects.json's settings belong to another client when none of its projects is here
    wb = read_json(os.path.join(client, "workbench.json"))
    repos = main_checkouts(client)
    rel = lambda p: p and (os.path.relpath(os.path.realpath(os.path.expanduser(p)), client)
                           if inside(os.path.realpath(os.path.expanduser(p)), client) else p)
    print(f"\n{B}gig init{O} {D}· {client}{O}")
    print(f"{D}  enter keeps what is proposed, - leaves it empty, ctrl-c stops (nothing is written before the end)"
          + (f"\n  proposals from {' and '.join(n for n, ok in [('projects.json', mine), ('workbench.json', wb)] if ok)}" if mine or wb else "")
          + f"{O}\n")
    gig = {"name": ask(tty, "client name", wb.get("name") or os.path.basename(client).capitalize())}
    slug = re.sub(r"[^a-z0-9]+", "-", os.path.basename(client).lower()).strip("-")

    shared = next((d for d in ["_scripts", ".shared-claude-commands", ".claude/commands"] if os.path.isdir(os.path.join(client, d))), "")
    gig["commands"] = ask(tty, "folder of the scripts and claude commands the projects share", shared,
                          note=f"gig offers its .md files in its picker as /command KEY, and the skills of {PLUGIN_DIR} as /<plugin>:<skill> KEY")
    commands = os.path.join(client, gig["commands"]) if gig["commands"] else None
    has = lambda name: bool(commands) and os.path.isfile(os.path.join(commands, name))
    skills = [command for command, _ in plugin_skills(client)]
    command = lambda name: next((c for c in skills if c.endswith(f":{name}")), None) or (f"/{name}" if has(f"{name}.md") else None)

    print(f"\n{B}tickets{O}")
    wt = wb.get("tracker") or {}
    kind = choose(tty, "ticket tracker", ["jira", "other", "none"], wt.get("kind") or "jira")
    tracker = {"kind": kind}
    if kind == "jira":
        site = re.match(r"https?://[^/]+", top.get("ticket_url") or "")
        tracker["site"] = ask(tty, "Jira address", wt.get("site") or (site and site.group(0)) or f"https://{slug}.atlassian.net")
        email = next((e for e in (git_out(p, "config", "user.email") for _, p in repos) if e), "")
        tracker["user"] = ask(tty, "Jira login (email)", wt.get("user") or email)
        tracker["keychain"] = keychain_item(tty, "Jira token", "workbench" if wt.get("keychain") else "gig",
                                            wt.get("keychain") or f"{slug}-jira")
    if kind != "none":
        meta = f"{gig['commands']}/jira-ticket-meta.sh" if kind == "jira" and has("jira-ticket-meta.sh") else ""
        tracker["ticket_info"] = ask(tty, "command that prints a ticket as JSON", rel(top.get("ticket_info")) or meta,
                                     note='gig runs it with the key: {"summary", "subtask", "parent"} name the branch and its base')
        tracker["ticket_url"] = ask(tty, "a ticket's link, {key} for the key", top.get("ticket_url")
                                    or (f"{tracker['site']}/browse/{{key}}" if kind == "jira" else ""))
    gig["tracker"] = tracker

    print(f"\n{B}code{O}")
    wc = wb.get("code") or {}
    hosts = [host_of(git_out(p, "remote", "get-url", "origin")) for _, p in repos]
    host = max(set(filter(None, hosts)), key=hosts.count, default=None)
    kind = choose(tty, "code host", ["gitlab", "github", "none"],
                  wc.get("kind") or ("github" if host == "github.com" else "gitlab" if host else "none"))
    code = {"kind": kind}
    if kind == "gitlab":
        code["site"] = ask(tty, "GitLab address", wc.get("site") or (f"https://{host}" if host else ""))
        code["keychain"] = keychain_item(tty, "GitLab token (api scope)", "workbench" if wc.get("keychain") else "gig",
                                         wc.get("keychain") or f"{slug}-gitlab")
        code["vpn"] = confirm(tty, "reachable only through a VPN?", bool(wc.get("vpn")))
    elif kind == "github":
        ok = bool(shutil.which("gh")) and run(["gh", "auth", "status"]).returncode == 0
        print(f"  {G}✓{O} {D}gh is logged in{O}" if ok else f"  {R}✗{O} {D}gh missing or logged out: brew install gh, gh auth login{O}")
    gig["code"] = code

    print(f"\n{B}agents{O}")
    gig["agent_args"] = shlex.split(ask(tty, "claude flags", shlex.join(top.get("agent_args", [])),
                                        note="every agent starts as: claude <flags> '<first message>'"))
    requests = {p.get("ticket_request") for p in mine.values() if p.get("ticket_request")}
    wtasks = wc.get("tasks") or {}
    tasks = {"work": ask(tty, "first message on a ticket ({key} is its key)",
                         "Ticket {key}. " + requests.pop() if len(requests) == 1
                         else "Ticket {key}. Read it and propose a plan before you change anything.")}
    if code["kind"] != "none":
        tasks["review"] = ask(tty, "first message to review a merge request ({url} is its link)", wtasks.get("review")
                              or (f"{command('code-review')} {{url}}" if command("code-review") else "Review the merge request {url}."))
        tasks["answer"] = ask(tty, "first message to answer the review on yours", wtasks.get("answer")
                              or (f"{command('gitlab-code-review')} {{url}}" if command("gitlab-code-review") else "Answer the review on {url}."))
    gig["tasks"] = tasks

    print(f"\n{B}projects{O}")
    projects = []
    for name, folder in repos:
        if folder in mine:
            p = mine[folder]
            projects.append({"name": p["name"], "dir": name, "ticket_prefix": p.get("ticket_prefix"),
                             "base_branch": p.get("base_branch") or "master", "copy": p.get("copy", []), "install": p.get("install", True)})
            print(f"{G}✓{O} {B}{p['name']}{O} {D}from projects.json: prefix {p.get('ticket_prefix') or '-'}, base {p.get('base_branch')}{O}")
    others = [name for name, folder in repos if folder not in mine]
    for name in choose(tty, "other repositories you take tickets in", others, multi=True) if others else []:
        folder = os.path.join(client, name)
        keys = [KEY.match(w.split("--", 1)[1]) for w in os.listdir(client) if w.startswith(name + "--")]
        # a prefix that spans projects (COMBINED) or that another project has already is no guess for this one
        taken = {p["ticket_prefix"] for p in projects if p.get("ticket_prefix")} | set(top.get("extra_ticket_prefixes", []))
        prefixes = [k.group(0).rsplit("-", 1)[0].upper() for k in keys if k]
        prefixes = [x for x in prefixes if x not in taken]
        base = (git_out(folder, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")   # none where it was pushed, not cloned
                or next((b for b in ["origin/main", "origin/master"] if has_ref(folder, b)), "origin/master")).split("/", 1)[1]
        ignored = [f for f in ["CLAUDE.md", ".claude", ".mcp.json", ".githooks"]
                   if os.path.exists(os.path.join(folder, f)) and git(folder, "check-ignore", "-q", f).returncode == 0]
        projects.append({"name": name, "dir": name,
                         "ticket_prefix": ask(tty, f"{name}: ticket prefix", max(set(prefixes), key=prefixes.count, default="")) or None,
                         "base_branch": ask(tty, f"{name}: base branch", base),
                         "copy": ask(tty, f"{name}: git-ignored files a worktree needs", " ".join(ignored)).split(),
                         "install": confirm(tty, f"{name}: pnpm install in a new worktree?", os.path.exists(os.path.join(folder, "pnpm-lock.yaml")))})
    gig["projects"] = projects

    print()
    if tty and not confirm(tty, f"write {path}?"):
        raise Stop("nothing written")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(gig, f, indent=2, ensure_ascii=False)
        f.write("\n")
    print(f"{G}✓{O} {B}{path}{O} {D}written: edit it any time, gig reads it in every folder below {client}{O}")
    client_plugin(tty, client, slug, gig)


def client_plugin(tty, client, slug, gig):
    """A Claude Code plugin for the client when the folder above is a plugin marketplace (.claude-plugin/
    marketplace.json): PLUGIN_DIR in the client's folder, listed there by the client's slug and enabled in each
    project with local scope, in .claude/settings.local.json, so its skills stay out of other clients' projects."""
    market = os.path.dirname(client)
    catalog_file = os.path.join(market, ".claude-plugin", "marketplace.json")
    catalog = read_json(catalog_file)
    root = os.path.join(client, PLUGIN_DIR)
    if not catalog.get("name") or os.path.exists(root) or any(p.get("name") == slug for p in catalog.get("plugins", [])):
        return
    plugin = f"{slug}@{catalog['name']}"
    print(f"\n{B}claude plugin{O}")
    if not confirm(tty, f"a plugin {plugin} for the skills of this client's projects, as /{slug}:<skill>?"):
        return
    os.makedirs(os.path.join(root, ".claude-plugin"))
    manifest = {"name": slug, "description": f"{gig['name']} workflows."}
    catalog.setdefault("plugins", []).append({**manifest, "source": f"./{os.path.basename(client)}/{PLUGIN_DIR}"})
    for file, data in [(os.path.join(root, ".claude-plugin", "plugin.json"), manifest), (catalog_file, catalog)]:
        with open(file, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
    print(f"{G}✓{O} {B}{root}{O} {D}written and listed in {catalog_file}: skills go in skills/<skill>/SKILL.md{O}")
    folders = [(p["name"], os.path.join(client, p["dir"])) for p in gig["projects"]]
    if not folders or not confirm(tty, f"enable it in the {len(folders)} projects, for you alone?"):
        return
    if not shutil.which("claude"):
        print(f"  {R}✗{O} {D}claude missing: in each project, claude plugin install {plugin} --scope local{O}")
        return
    failed = False
    for name, folder in folders:
        # local scope writes .claude/settings.local.json: in a repository that does not ignore it, it would get committed
        if git(folder, "check-ignore", "-q", ".claude/settings.local.json").returncode != 0:
            print(f"  {R}✗{O} {B}{name}{O} {D}git does not ignore .claude/settings.local.json: not enabled{O}")
            continue
        r = subprocess.run(["claude", "plugin", "install", plugin, "--scope", "local"], cwd=folder,
                           capture_output=True, text=True, timeout=120)
        failed = failed or r.returncode != 0
        print(f"  {G}✓{O} {B}{name}{O}" if r.returncode == 0 else f"  {R}✗{O} {B}{name}{O} {D}{tail(r.stdout + r.stderr)}{O}")
    if failed:
        print(f"  {D}is the marketplace added on this machine? claude plugin marketplace add {market}{O}")


# gig KEY [ACTION]: the command a person types, and with no KEY its menus. ACTION is work (open), review or answer
# (open the merge request's branch with tasks.review or tasks.answer), close, or a /command claude starts with.
ACTIONS = [("work", "start the ticket: a new conversation with its first message"), ("review", "review its merge request"),
           ("answer", "answer the review on my merge request"), ("close", "close its worktree, branch and windows"),
           ("tag", "a reminder on the ticket: waiting for someone, blocked …")]
USAGE = "usage: gig [KEY [work|review|answer|close|/command] [-p PROJECT] [-n] [-f]]"


def fzf(rows, *options):
    """fzf full screen over rows of value<TAB>shown: its exit code and the lines it printed."""
    r = subprocess.run([*FZF, *options], input="\n".join(rows), stdout=subprocess.PIPE, text=True)
    return r.returncode, r.stdout.splitlines()


def pretty(line):
    """A line of open or close for a person: the ticket as a title, "label: value" in columns, ~ for home."""
    line = line.replace(os.path.expanduser("~"), "~")
    if line == "herdr: close no space":
        return None
    if line == "pnpm install ...":
        return f"   {D}{'install':<12}{O} pnpm install …"
    if re.match(r"[A-Z][A-Z0-9]*-\d+: ", line):
        return f"\n   {B}{line}{O}\n"
    if line.startswith("  "):
        return f"   {'':12} {D}{line.strip()}{O}"
    label = re.match(r"([a-z][a-z ]*): (.*)", line)
    return f"   {D}{label.group(1):<12}{O} {label.group(2)}" if label else f"   {line}"


class Pretty:
    """stdout for a person at a terminal: each line through pretty()."""
    def __init__(self, out):
        self.out, self.part = out, ""

    def write(self, text):
        *lines, self.part = (self.part + text).split("\n")
        for line in lines:
            shown = pretty(line)
            if shown is not None:
                self.out.write(shown + "\n")
        self.out.flush()
        return len(text)

    def flush(self):
        self.out.flush()


def read_key():
    """One key from the terminal, raw. An arrow key sends esc and more after it: those come along, so a lone esc
    is told apart."""
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    before = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        key = os.read(fd, 1)
        if select.select([fd], [], [], 0.05)[0]:
            key += os.read(fd, 16)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, before)
    return key


def back_to_menu():
    """After an error the popup waits: any key goes back to the menu (True), esc closes it (False)."""
    print(f"\n   {D}any key: back to the menu · esc: close{O}", end="", flush=True)
    return read_key() != b"\x1b"


def sure(question):
    """y or n, one key. Straight to the terminal: Pretty holds back a line without its end, as this one."""
    sys.stdout.flush()
    print(f"\n   {question} {D}[y/N]{O} ", end="", flush=True, file=sys.__stdout__)
    yes = read_key() in (b"y", b"Y")
    print("y" if yes else "n", file=sys.__stdout__, flush=True)
    return yes


def menus_loop(parser):
    """gig with no KEY at a terminal (the popup): the menus again after an error, or after esc in a picker that
    follows them, until a ticket opens or esc in the first menu."""
    import traceback
    start = os.getcwd()
    while True:
        os.chdir(start)   # close and review move to another folder
        try:
            return run_gig(parser, menus())
        except SystemExit as e:
            if e.code != 130:   # esc in the first menu: 0
                raise
            continue
        except Stop as e:
            sys.stdout.flush()
            sys.stdout = sys.__stdout__   # Pretty holds back a line without its end: the prompt has none
            print(f"\n   {R}✗ {e}{O}", file=sys.stderr)
        except Exception:
            sys.stdout.flush()
            sys.stdout = sys.__stdout__
            traceback.print_exc()
        if not back_to_menu():
            sys.exit(1)


def skill_description(path):
    """The description: line of a SKILL.md's front matter (between the first two --- lines)."""
    with open(path, encoding="utf-8") as f:
        lines = f.read().split("\n")
    head = lines[1:lines.index("---", 1)] if lines[0] == "---" and "---" in lines[1:] else []
    return next((line.split(":", 1)[1].strip().strip('"') for line in head if line.startswith("description:")), "")


def plugin_skills(client):
    """The skills of the client's plugin (PLUGIN_DIR), as claude takes them: /<plugin>:<skill>, with their description."""
    root = os.path.join(client, PLUGIN_DIR)
    name = read_json(os.path.join(root, ".claude-plugin", "plugin.json")).get("name")
    skills = os.path.join(root, "skills")
    for skill in sorted(os.listdir(skills)) if name and os.path.isdir(skills) else []:
        path = os.path.join(skills, skill, "SKILL.md")
        if os.path.isfile(path):
            yield f"/{name}:{skill}", skill_description(path)


def command_rows(client, config):
    """The client's claude commands: its plugin's skills, then the .md files of gig.json's commands with the first
    line of each."""
    rows = list(plugin_skills(client)) if client else []
    folder = os.path.join(client, config.get("commands") or "") if client and config.get("commands") else None
    for name in sorted(os.listdir(folder)) if folder and os.path.isdir(folder) else []:
        if name.endswith(".md"):
            with open(os.path.join(folder, name), encoding="utf-8") as f:
                rows.append((f"/{name[:-3]}", f.readline().strip()))
    width = max([21, *(len(command) + 1 for command, _ in rows)])
    for command, about in rows:
        yield f"{command}\t{B}{command:<{width}}{O} {D}{about[:70]}{O}"


# The ticket list is also the agents' overview: each worktree with the state of claude in its window (from
# claude agents --json, through the pane's tty) and its tag, the reminder the Herdr workbench keeps per branch.
TAGS = os.path.join(os.getenv("HERDR_APP_HOME") or os.path.expanduser("~/.config/herdr-app"), "data", "workbench", "tags.json")
Y = "\033[33m" if sys.stdout.isatty() else ""
# claude's status: the order in the list (who needs you first) and how it shows
STATES = {"waiting": (0, f"{Y}⏳{O}"), "idle": (1, f"{G}✓ {O}"), "busy": (2, f"{C}⚡{O}")}


def transcripts(folder):
    """Where claude keeps the conversations had in folder: its path with every other character than a letter or
    a digit as -, in the projects of its config folder (CLAUDE_CONFIG_DIR, else ~/.claude)."""
    home = os.getenv("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    return os.path.join(home, "projects", re.sub(r"[^A-Za-z0-9]", "-", folder))


def resume(folder, key):
    """claude again on the worktree's last conversation (--continue), in a new window of the current session:
    False outside tmux or when it has none."""
    found = transcripts(folder)
    if not os.getenv("TMUX") or not (os.path.isdir(found) and any(n.endswith(".jsonl") for n in os.listdir(found))):
        return False
    argv = ["env", "-u", "ANTHROPIC_API_KEY", "claude", *(load_config(folder).get("agent_args") or []), "--continue"]
    open_tmux(argparse.Namespace(task=None, dry_run=False), key, folder, argv, None)
    return True


def agents():
    """The interactive claude agents in tmux panes, by the worktree of their window (its @roger_worktree, else
    their folder): status, pane, window and seconds since their transcript last changed. Of two on one worktree
    (the ticket's and a review) the one that needs you first."""
    try:
        listed = json.loads(run(["claude", "agents", "--json"], timeout=15).stdout or "[]")
        panes = {}
        for line in tmux("list-panes", "-a", "-F", "#{pane_tty}\t#{pane_id}\t#{window_id}\t#{@roger_worktree}").splitlines():
            tty, pane, window, *worktree = line.split("\t")
            panes[tty.removeprefix("/dev/")] = (pane, window, "".join(worktree))
    except (ValueError, OSError, subprocess.TimeoutExpired, Stop):
        return {}
    ttys = dict(line.split() for line in run(["ps", "-Ao", "pid=,tty="]).stdout.splitlines() if len(line.split()) == 2)
    found = {}
    for agent in listed:
        where = panes.get(ttys.get(str(agent.get("pid")))) if agent.get("kind") == "interactive" else None
        if not where:
            continue
        pane, window, worktree = where
        cwd = agent.get("cwd") or ""
        transcript = os.path.join(transcripts(cwd), f"{agent.get('sessionId')}.jsonl")
        age = time.time() - os.path.getmtime(transcript) if os.path.exists(transcript) else None
        state = {"status": agent.get("status"), "pane": pane, "window": window, "age": age}
        folder = os.path.realpath(worktree or cwd)
        if folder not in found or STATES.get(state["status"], (3,))[0] < STATES.get(found[folder]["status"], (3,))[0]:
            found[folder] = state
    return found


def branch_of(worktree):
    """A worktree's branch, read from its HEAD: no git run for each row."""
    try:
        with open(os.path.join(worktree, ".git"), encoding="utf-8") as f:
            gitdir = os.path.join(worktree, f.read().split("gitdir:", 1)[1].strip())
        with open(os.path.join(gitdir, "HEAD"), encoding="utf-8") as f:
            head = f.read().strip()
    except (OSError, IndexError):
        return None
    return head.removeprefix("ref: refs/heads/") if head.startswith("ref: refs/heads/") else None


def set_tag(branch, text):
    """As workbench-tag TEXT and --clear: the tag of a branch; an empty one goes, the review round stays."""
    tags = read_json(TAGS)
    entry = dict(tags.get(branch) or {}, tag=text)
    if not text:
        del entry["tag"]
    if entry:
        tags[branch] = entry
    else:
        tags.pop(branch, None)
    os.makedirs(os.path.dirname(TAGS), exist_ok=True)
    with open(TAGS + ".tmp", "w", encoding="utf-8") as f:
        json.dump(tags, f, indent=2, ensure_ascii=False)
    os.replace(TAGS + ".tmp", TAGS)
    redraw()   # the sidebars show tags


def ask_tag(folder):
    """The tag of the worktree in folder, asked with fzf: what is there now to edit, empty clears it."""
    branch = branch_of(folder)
    if not branch:
        return
    now = (read_json(TAGS).get(branch) or {}).get("tag") or ""
    code, out = fzf([], "--border-label", f" gig · {branch} ", "--input-label", " tag ", "--query", now, "--print-query",
                    "--ghost", "a reminder: waiting for Johannes, blocked by the API … (empty clears it)",
                    "--header", "enter saves · esc leaves it", "--list-border", "none", "--no-separator")
    if code in (0, 1):
        set_tag(branch, (out[:1] or [""])[0].strip())


def go_to(folder):
    """The window open on folder, shown: True when there is one."""
    found = windows_on(folder) if folder else []
    if found:
        session, window, _ = found[0]
        tmux("select-window", "-t", window)
        tmux("switch-client", "-t", session)
    return bool(found)


def worktree_rows(client, config):
    """The client's ticket worktrees (repo--KEY-slug): the ones whose agent needs you first, then the newest.
    Fields: KEY|project|folder (a ticket with worktrees in two projects is opened in the one picked), the agent's
    pane for the preview (- without one), what shows."""
    projects = {p["dir"]: p["name"] for p in config.get("projects") or []}
    running, tags = agents(), read_json(TAGS)
    try:
        windows = {os.path.realpath(p) for p in tmux("list-windows", "-a", "-F", "#{@roger_worktree}").splitlines() if p}
    except (Stop, OSError):
        windows = set()
    rows = []
    for name in os.listdir(client):
        folder = os.path.realpath(os.path.join(client, name))
        if "--" not in name or not os.path.isfile(os.path.join(folder, ".git")):
            continue
        repo, rest = name.split("--", 1)
        branch = branch_of(folder)
        # the branch's key: a folder's name can say another ticket (web--ACME-915-echo on ACME-916-…)
        named = branch if branch and KEY.match(branch) else rest
        key = KEY.match(named)
        if not key:
            continue
        words = named[len(key.group(0)):].strip("-").replace("-", " ")
        agent = running.get(folder) or {}
        rank, icon = STATES.get(agent.get("status"), (3, f"{D}○{O}" if folder in windows else f"{D}·{O}"))
        age = agent.get("age")
        shown_age = "" if age is None else "now" if age < 60 else f"{age // 60:.0f}m" if age < 3600 else f"{age // 3600:.0f}h" if age < 86400 else f"{age // 86400:.0f}d"
        tag = (tags.get(branch) or {}).get("tag") or ""
        value = "|".join([key.group(0), projects.get(repo, ""), folder])
        rows.append((rank, -os.path.getmtime(folder), f"{value}\t{agent.get('pane', '-')}\t{icon} {B}{key.group(0):<17}{O} "
                     f"{D}{repo[:15]:<15}{O} {shown_age:>4}  {Y}{tag[:28]:<28}{O} {D}{words}{O}"))
    return [row for _, _, row in sorted(rows)]


NAV, TYPING = "  ", "❯ "   # fzf's prompt in each mode, which esc reads to know where it is


def modal(*keys, nav, typing):
    """fzf in two modes, as in vim: in nav mode j/k move and keys are commands, i or / starts typing, esc stops it,
    esc in nav mode leaves. nav and typing are the ghost texts of each mode (no commas or brackets in them)."""
    letters = ",".join(["j", "k", "g", "G", "q", "i", "/", *keys])
    to_typing = f"unbind({letters})+change-prompt({TYPING})+change-ghost({typing})"
    to_nav = f"rebind({letters})+change-prompt({NAV})+change-ghost({nav})"
    return ["--prompt", NAV, "--ghost", nav, "--bind", "j:down,k:up,g:first,G:last,q:abort",
            "--bind", f"i:{to_typing},/:{to_typing}",
            "--bind", f"esc:transform:[ \"$FZF_PROMPT\" = '{TYPING}' ] && echo '{to_nav}' || echo abort"]


def menus():
    """gig with no KEY: the tickets with their agents, then what to do with one. Vim-like: j/k move, enter goes in
    (or resumes the last conversation, or opens), o r a x t act, space shows every action, i types; esc stops
    typing, then goes back or leaves."""
    client = client_dir()
    config = read_json(os.path.join(client, CONFIG_NAME)) if client else {}
    title = f" gig · {config['name']} " if config.get("name") else " gig "
    preview = 'p={2}; if [ "$p" = - ]; then echo "no claude in a window"; else tmux capture-pane -ept "$p" | tail -n "$FZF_PREVIEW_LINES"; fi'
    keys = {"o": "open", "r": "review", "a": "answer", "x": "close", "t": "tag", "space": "menu"}
    while True:
        code, out = fzf(worktree_rows(client, config) if client else [], "--with-nth", "3..", "--border-label", title,
                        "--input-label", " ticket ", "--list-label", " ⏳ needs you  ✓ your turn  ⚡ working  ○ window, no claude ",
                        *modal(*keys, nav="j k move · i types a key or a branch or a merge request link",
                               typing="a key or a branch or a merge request link · esc stops typing"),
                        "--bind", ",".join(f"{k}:print({a})+accept" for k, a in keys.items()),
                        "--bind", "ctrl-o:print(open)+accept,ctrl-t:print(tag)+accept,alt-enter:print(typed)+accept",
                        "--preview", preview, "--preview-window", "right,45%,nowrap", "--header",
                        "⏎ go in or resume · o open · r review · a answer · x close · t tag · ␣ all actions · i type · esc quit",
                        "--print-query")
        if code not in (0, 1):
            raise SystemExit(0)
        typed, *rest = out or [""]
        chosen = rest[-1] if rest and "\t" in rest[-1] else ""
        did = next((line for line in rest if "\t" not in line), "")   # what a key printed: open, close, tag …
        value = typed if did == "typed" or not chosen else chosen.split("\t", 1)[0]
        key, project, folder = (value.split("|") + ["", ""])[:3]
        p = ["-p", project] if project else []
        if not key:
            raise SystemExit(0)
        if did == "tag":
            ask_tag(folder)
            continue
        if did == "close":
            if sure(f"close {key}? its worktree and local branch go, origin's stays"):
                return [folder, "close"] if folder else [key, "close", *p]   # a row's own folder: exactly that worktree
            continue
        if did in ("review", "answer"):
            return [key, did]
        if chosen and did in ("", "open"):   # enter or o on a ticket: its window, else its last conversation, else open it
            if go_to(folder) or resume(folder, key):
                raise SystemExit(0)
            return [key, "work", *p]
        rows = [f"{a}\t{B}{a:<8}{O} {D}{about}{O}" for a, about in ACTIONS] + list(command_rows(client, config))
        code, out = fzf(rows, "--border-label", f" gig · {key} ", "--input-label", " action ", "--list-label", " what to do ",
                        *modal(nav="j k move · enter runs · i types a /command", typing="a /command · esc stops typing"),
                        "--header", "⏎ run · i type · esc back", "--print-query")
        if code not in (0, 1):
            continue
        typed, chosen = (out + ["", ""])[:2]
        action = chosen.split("\t", 1)[0] if chosen else typed or "work"
        if action == "tag":
            ask_tag(folder)
            continue
        if action == "close" and not sure(f"close {key}? its worktree and local branch go, origin's stays"):
            continue
        if action == "close" and folder:
            return [folder, "close"]
        return [key, action, *(p if action not in ("review", "answer") else [])]


def gitlab(code, path):
    """GET on the client's GitLab API. The token comes from the Keychain item gig.json names and goes to curl on
    stdin, never on a command line or in a message."""
    item = code.get("keychain") or {}
    service, account = item.get("service") or "gig", item.get("account") or ""
    r = run(["security", "find-generic-password", "-s", service, "-a", account, "-w"])
    if r.returncode != 0:
        raise Stop(f"no GitLab token in the Keychain ({service} / {account})")
    got = subprocess.run(["curl", "-sSf", "--max-time", "20", "-K", "-", f"{code.get('site', '').rstrip('/')}/api/v4/{path}"],
                         input=f'header = "PRIVATE-TOKEN: {r.stdout.strip()}"\n', capture_output=True, text=True)
    if got.returncode != 0:
        raise Stop("GitLab did not answer" + (" (VPN off?)" if code.get("vpn") else "") + ": " + tail(got.stderr))
    return json.loads(got.stdout)


def of_ticket(key):
    """Whether a merge request is the ticket's: its key a word of the title (XSHOP-1 is not SHOP-1's), or a
    branch of it."""
    word = re.compile(rf"(?<![A-Za-z0-9]){re.escape(key)}(?!\d)", re.I)
    return lambda m: bool(word.search(m["title"])) or m["source_branch"].upper().startswith(key + "-")


def merge_request(code, ref, action):
    """The open merge request of ref, a ticket key (in its title or branch) or the merge request's link: its link and
    branch. For answer only mine."""
    from urllib.parse import quote
    if ref.startswith("http"):
        project, _, iid = re.sub(r"^https?://[^/]+/", "", ref).partition("/-/merge_requests/")
        number = re.match(r"\d+", iid)
        if not number:
            raise Stop(f"no merge request in {ref}")
        found = [gitlab(code, f"projects/{quote(project, safe='')}/merge_requests/{number.group(0)}")]
    else:
        key = ref.upper()
        scope = "created_by_me" if action == "answer" else "all"
        found = [m for m in gitlab(code, f"merge_requests?state=opened&scope={scope}&in=title&search={quote(key)}&per_page=50")
                 if of_ticket(key)(m)]
    if not found:
        raise Stop(f"no open merge request for {ref}: gig <merge request link> {action}")
    if len(found) > 1:
        if not ASK:
            raise Stop(f"several merge requests, run gig <link> {action} with one of: "
                       + ", ".join(f"{m['web_url']} ({m['title']})" for m in found))
        picked, out = fzf([f"{i}\t{m['title']}  {D}{m['source_branch']}{O}" for i, m in enumerate(found)],
                          "--border-label", " gig ", "--input-label", " which merge request? ")
        if picked != 0 or not out:
            raise SystemExit(130)
        found = [found[int(out[0].split("\t", 1)[0])]]
    return found[0]["web_url"], found[0]["source_branch"]


def project_path(folder):
    """The GitLab project (group/repo) of a checkout, from its origin."""
    url = git_out(folder, "remote", "get-url", "origin") or ""
    return re.sub(r"\.git$", "", re.sub(r"^(?:[a-z+]+://[^/]+/|[^@/]+@[^:]+:)", "", url))


def repo_of(client, project):
    """The client's main checkout of a GitLab project (group/repo), from its origin."""
    for _, folder in main_checkouts(client):
        if project_path(folder) == project:
            return folder
    return None


def run_gig(parser, argv):
    key, rest = argv[0], argv[1:]
    action = "work"
    if rest and not rest[0].startswith("-"):
        action, rest = rest[0], rest[1:]
    client = client_dir()
    if action == "work":
        argv = ["open", key, *rest]
    elif action == "close":
        os.chdir(client or os.path.expanduser("~"))   # close refuses to run inside the worktree
        argv = ["close", key, *rest]
    elif action in ("review", "answer"):
        config = load_config()
        code, task = config.get("code") or {}, (config.get("tasks") or {}).get(action)
        if not client:
            raise Stop(f"{action} needs a client's gig.json: gig init in the client's folder")
        if code.get("kind") != "gitlab":
            raise Stop(f"{action} knows GitLab only, not {code.get('kind') or 'no code host'}")
        if not task:
            raise Stop(f"no tasks.{action} in {config['_file']}")
        if ASK:
            print(f"\n   {D}looking for the merge request of {key} …{O}", flush=True)
        url, branch = merge_request(code, key, action)
        project = re.sub(r"^https?://[^/]+/", "", url).partition("/-/merge_requests/")[0]
        repo = repo_of(client, project)
        if not repo:
            raise Stop(f"no checkout of {project} in {client}")
        os.chdir(repo)   # with a branch and a task, open takes the project from the folder
        argv = ["open", branch, "--task", task.replace("{url}", url), *rest]
    elif action.startswith("/"):
        argv = ["open", key, "--task", f"{action} {key}", *rest]
    else:
        raise Stop(f"unknown action {action}: work, review, answer, close or a /command")
    args = parser.parse_args(argv)
    if ASK:
        sys.stdout = Pretty(sys.stdout)
    (open_ticket if args.command == "open" else close_ticket)(args)


# gig notify: Claude Code's hooks call it. The window of the claude shows its state beside its name (@gig_state,
# which .tmux.conf puts into the theme's window formats): no status bar job asks every few seconds.
STATE_ICONS = {"busy": "⚡", "waiting": "⏳", "done": "✓", "ready": "✓"}
SOUNDS = {"waiting": "Ping", "done": "Glass"}


def notify(args):
    """A hook of a claude in a tmux pane: the state of its window (busy: UserPromptSubmit and PostToolUse, waiting:
    Notification, done: Stop, ready: SessionStart, end: SessionEnd takes it away). Waiting (it asks you something)
    and done (your turn) also get a macOS notification with a sound and a bell in the window, which tmux marks
    until you go there: not when you are looking at that pane. Nothing outside tmux; a hook never fails."""
    pane = os.getenv("TMUX_PANE")
    if not pane:
        return
    try:
        hook = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        hook = {}
    try:
        state = STATE_ICONS.get(args.event, "")
        if tmux("show-options", "-wqv", "-t", pane, "@gig_state") != state:   # busy comes after every tool
            tmux("set-option", "-w", *(["-t", pane, "@gig_state", state] if state else ["-u", "-t", pane, "@gig_state"]))
            redraw()
        if args.event not in SOUNDS:
            return
        fields = tmux("display-message", "-p", "-t", pane, "#{window_name}\t#{pane_tty}\t#{@roger_worktree}\t#{pane_current_path}")
        name, tty, worktree, cwd = (fields.split("\t") + ["", "", "", ""])[:4]
        for line in tmux("list-clients", "-F", "#{client_flags}\t#{pane_id}").splitlines():
            flags, shown = (line.split("\t") + [""])[:2]
            if shown == pane and "focused" in flags.split(","):
                return
    except (Stop, OSError):
        return
    title = name if worktree else f"{name} · {os.path.basename(cwd)}"
    message = hook.get("message") if args.event == "waiting" and hook.get("message") else \
        "asks you something" if args.event == "waiting" else "done, your turn"
    run(["osascript", "-e", "on run argv", "-e",
         "display notification (item 1 of argv) with title (item 2 of argv) sound name (item 3 of argv)",
         "-e", "end run", message, title, SOUNDS[args.event]])
    try:
        with open(tty, "w") as bell:   # tmux sees the bell as the pane's own: the window gets its flag
            bell.write("\a")
    except OSError:
        pass


# gig sidebar: the session's windows in a narrow pane on the left, as Herdr lists its spaces: a card for each, with
# its number, the agent's state, the ticket, its project, the words of its branch and its tag, in the theme's
# colours over the terminal's own background. One
# pane per session that follows you: tmux's hooks move it into the window you go to (--follow), prefix+b shows and
# hides it (--toggle), and the status bar goes while it shows. It draws again when the redraw channel (tmux
# wait-for) is signalled: by tmux's hooks, gig notify, a tag set in the menu and .tmux.conf (a new theme).
SIDEBAR_WIDTH = "32"   # @gig_sidebar_width in .tmux.conf takes another
REDRAW = "gig-sidebar"


def sidebar_width():
    return tmux("show-options", "-gqv", "@gig_sidebar_width") or SIDEBAR_WIDTH


def redraw():
    try:
        tmux("wait-for", "-S", REDRAW)
    except (Stop, OSError, subprocess.TimeoutExpired):
        pass


def sidebar_pane(session):
    """The session's sidebar pane, if it is on and still there (a window closed with it): (on, pane)."""
    shown = tmux("show-options", "-qv", "-t", session, "@gig_sidebar")
    panes = tmux("list-panes", "-s", "-t", session, "-F", "#{pane_id}").split()
    return bool(shown), shown if shown in panes else None


def follow(session):
    """The sidebar into the session's current window, made again if it went with a window. A window it is alone
    in (its claude ended) closes: the sidebar goes back to the last window."""
    on, pane = sidebar_pane(session)
    if not on:
        return
    window = tmux("display-message", "-p", "-t", session, "#{window_id}")
    if pane:
        here, panes = tmux("display-message", "-p", "-t", pane, "#{window_id}\t#{window_panes}").split("\t")
        if here == window and panes == "1":
            if tmux("display-message", "-p", "-t", session, "#{session_windows}") == "1":
                tmux("kill-pane", "-t", pane)   # the session's last window: it ends, as without the sidebar
                return
            try:
                tmux("last-window", "-t", session)
            except Stop:
                tmux("next-window", "-t", session)
            window = tmux("display-message", "-p", "-t", session, "#{window_id}")
        if here != window:
            tmux("join-pane", "-d", "-f", "-h", "-b", "-l", sidebar_width(), "-s", pane, "-t", window)
    else:
        made = tmux("show-options", "-qv", "-t", session, "@gig_sidebar_made")
        if made and time.time() - float(made) < 2:   # it ended as soon as it started: no loop of new panes
            tmux("set-option", "-u", "-t", session, "@gig_sidebar")
            tmux("set-option", "-u", "-t", session, "status")
            raise Stop("the sidebar ended as it started")
        tmux("set-option", "-t", session, "@gig_sidebar_made", str(time.time()))
        pane = tmux("split-window", "-d", "-f", "-h", "-b", "-l", sidebar_width(), "-t", window, "-c", os.path.expanduser("~"),
                    "-P", "-F", "#{pane_id}", shlex.join([os.path.abspath(sys.argv[0]), "sidebar"]))
        tmux("set-option", "-p", "-t", pane, "@gig_sidebar_pane", "1")
        tmux("set-option", "-t", session, "@gig_sidebar", pane)
    redraw()


def toggle_sidebar(session):
    on, pane = sidebar_pane(session)
    if on:
        tmux("set-option", "-u", "-t", session, "@gig_sidebar")
        tmux("set-option", "-u", "-t", session, "status")   # the global one again
        if pane:
            tmux("kill-pane", "-t", pane)
    else:
        tmux("set-option", "-t", session, "@gig_sidebar", "on")
        tmux("set-option", "-t", session, "status", "off")
        follow(session)


HEX = re.compile(r"#[0-9a-fA-F]{6}")
NAMED = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]


def paint(color, ground=38):
    """The escape for a tmux colour (#rrggbb, colourN or a name) as foreground (38) or background (48): "" for
    default and the ones it does not know. Each piece ends with 39 or 49, never 0: a card's background stays."""
    if HEX.fullmatch(color or ""):
        return f"\033[{ground};2;" + ";".join(str(int(color[i:i + 2], 16)) for i in (1, 3, 5)) + "m"
    number = re.fullmatch(r"colou?r(\d+)", color or "")
    if number:
        return f"\033[{ground};5;{number.group(1)}m"
    return f"\033[{ground - 8 + NAMED.index(color)}m" if color in NAMED else ""


def ink(color, text, bold=False):
    return paint(color) + ("\033[1m" if bold else "") + text + ("\033[22m" if bold else "") + "\033[39m"


def mix(a, b, part):
    """Colour a moved towards b by part (0 to 1), both #rrggbb; a as it is when either is not."""
    if not (HEX.fullmatch(a or "") and HEX.fullmatch(b or "")):
        return a
    return "#" + "".join(f"{round(int(a[i:i + 2], 16) * (1 - part) + int(b[i:i + 2], 16) * part):02x}" for i in (1, 3, 5))


def cells(text):
    """The columns text takes, escapes aside: ⏳ and ⚡ take two."""
    plain = re.sub(r"\033\[[0-9;]*m", "", text)
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in plain)


def cut(text, room):
    """Plain text in room columns at most, … where it is cut."""
    if cells(text) <= room:
        return text
    out = ""
    for c in text:
        if cells(out + c) > room - 1:
            break
        out += c
    return out + "…"


def sidebar_theme():
    """The colours of the status bar the sidebar stands in for, whichever the theme: its text, the current window's
    colour as the accent, and shades towards its background for dim text and rules. No background of its own: the
    terminal's shows through (a transparent one too)."""
    style = dict(p.split("=", 1) for p in tmux("show-options", "-gv", "status-style").split(",") if "=" in p)
    bg, fg = style.get("bg", "default"), style.get("fg", "default")
    accent = re.search(r"#\[fg=([^],]+)", tmux("show-options", "-gv", "window-status-current-format"))
    return {"fg": fg, "accent": accent.group(1) if accent else "cyan", "tag": "yellow",
            "dim": mix(fg, bg, 0.45), "rule": mix(bg, fg, 0.2)}


def sidebar_view(pane):
    """The sidebar's screen: the session's windows as cards (number, state and ticket, project, the words of the
    branch, tag), the other sessions with their agents' states, the keys at the bottom. Also what each line goes to
    when clicked (a window or a session) and the current window."""
    session, name, width, height = tmux("display-message", "-p", "-t", pane,
                                        "#{session_id}\t#{session_name}\t#{pane_width}\t#{pane_height}").split("\t")
    width, height, tags, look = int(width), int(height), read_json(TAGS), sidebar_theme()
    rows, targets, current = [], {}, None

    def add(left, right="", target=None):
        room = width - cells(left) - cells(right)
        rows.append(left + " " * max(room, 0) + (right if room >= 1 or not right else ""))   # never glued to the left
        if target:
            targets[len(rows)] = target

    rule = " " + ink(look["rule"], "─" * (width - 2))
    add(" " + ink(look["fg"], cut(name, width - 2), bold=True))
    add(rule)
    windows = [(row.split("\t") + [""] * 8)[:8] for row in tmux(
        "list-windows", "-t", session, "-F", "#{window_id}\t#{window_index}\t#{window_active}\t#{window_bell_flag}\t"
        "#{@gig_state}\t#{@roger_worktree}\t#{window_name}\t#{pane_current_path}").splitlines()]
    for window, index, active, bell, state, worktree, title, path in windows:
        on, target = active == "1", ("window", window)
        current = window if on else current
        # who needs you, in the terminal's red and green: a question until you answer it, an end until you go there
        need = "" if on else "asks" if state == "⏳" else "done" if state == "✓" and bell == "1" else ""
        color = {"asks": "red", "done": "green"}.get(need)
        bar = ink(look["accent"], "▌") if on else ink(color, "┃") if need else " "
        number = ink(look["accent"] if on else color or look["dim"], f"{index:>2}", bold=on or bool(need))   # prefix and it: that window
        # ✓ is one column wide, ⏳ and ⚡ two; a ✓ you have seen is grey
        icon = ink(color or ("" if on else look["dim"]), state) + " " if state == "✓" else state or "  "
        dot = ink(look["tag"], " •") if bell == "1" and not on and not need else ""   # another program's bell
        branch = branch_of(worktree) or "" if worktree else ""
        key = (KEY.match(branch) or KEY.match(title) or [""])[0]
        shown = f"{key} {title[len(key) + 1:].replace('-', ' ')}" if key and title.startswith(key + "-") else title
        head = cut(shown, width - 8 - cells(dot) - (len(need) + 2 if need else 0))
        add(f"{bar}{number} {icon} " + ink(look["accent"] if on else color or look["fg"], head, bold=True) + dot,
            ink(color, need) + " " if need else
            "" if worktree else ink(look["dim"], cut(path.replace(os.path.expanduser("~"), "~"), width // 2)) + " ",
            target)
        if worktree:
            words = branch[len(key):].strip("-") if key and branch.startswith(key) else branch
            tag = (tags.get(branch) or {}).get("tag") or ""
            for text, color in ((os.path.basename(worktree).split("--", 1)[0], "dim"), (words.replace("-", " "), "dim"),
                                (tag and "⌁ " + tag, "tag")):
                if text:
                    add(f"{bar}      " + ink(look[color], cut(text, width - 8)), target=target)
        add(rule)
    sessions = [line.split("\t", 1) for line in tmux("list-sessions", "-F", "#{session_id}\t#{session_name}").splitlines()]
    states = {}
    for line in tmux("list-windows", "-a", "-F", "#{session_id}\t#{@gig_state}").splitlines():
        where, state = (line.split("\t") + [""])[:2]
        if state:
            states.setdefault(where, {}).setdefault(state, 0)
            states[where][state] += 1
    others = [(sid, other) for sid, other in sessions if sid != session]
    if others:
        add("")
        add(" " + ink(look["dim"], "other sessions"))
        for sid, other in others:
            count = " ".join(f"{icon}{states[sid][icon]}" for icon in ("⏳", "⚡", "✓") if states.get(sid, {}).get(icon))
            add("  " + cut(other, width - 4 - cells(count)), count + " ", ("session", sid))
    rows = rows[:max(height - 2, 1)]
    keys = tmux("show-options", "-gv", "prefix")
    rows += [""] * (height - 1 - len(rows)) + [" " + ink(look["dim"], cut(f"{keys} b hides · {keys} T gig", width - 2))]
    return "\n".join(rows), targets, current


def sidebar(args):
    """The sidebar itself, in its pane: draws, waits for the redraw channel (or a minute, for the tags), a resize
    or a click, which goes to the window clicked. Focus goes back where it came from: C-h does not stop here."""
    if args.follow or args.toggle:
        import fcntl
        import tempfile
        # one at a time: a window closing fires two hooks, and two followers would each make a sidebar
        with open(os.path.join(tempfile.gettempdir(), f"gig-sidebar-{os.getuid()}.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                return (follow if args.follow else toggle_sidebar)(args.follow or args.toggle)
            except Stop:   # a hook never fails
                return
    import select
    import termios
    import tty
    pane, fd = os.environ["TMUX_PANE"], sys.stdin.fileno()
    tty.setcbreak(fd, termios.TCSANOW)
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)
    signal.signal(signal.SIGWINCH, lambda *_: None)
    for ending in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(ending, lambda *_: sys.exit(0))
    sys.stdout.write("\033[?25l\033[?1004h\033[?1000h\033[?1006h")   # no cursor; focus and mouse reports
    waiter, targets, current = None, {}, None
    try:
        while True:
            try:
                screen, targets, current = sidebar_view(pane)
            except Stop:
                screen = ""
            sys.stdout.write("\033[H\033[J" + screen)
            sys.stdout.flush()
            if waiter is None:
                waiter = subprocess.Popen(["tmux", "wait-for", REDRAW], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            ready = select.select([fd, waiter.stdout, wake_r], [], [], 60)[0]
            if waiter.stdout in ready:   # signalled: it ended
                waiter.wait()
                waiter = None
            if wake_r in ready:
                os.read(wake_r, 64)
            if fd in ready:
                got = os.read(fd, 256)
                if b"\033[I" in got and not re.search(rb"\033\[<0;", got) and select.select([fd], [], [], 0.15)[0]:
                    got += os.read(fd, 256)   # a click: its focus comes first, the press after
                click = re.search(rb"\033\[<0;\d+;(\d+)M", got)
                kind, went = targets.get(int(click.group(1)), (None, None)) if click else (None, None)
                if kind == "window" and went != current:
                    tmux("select-window", "-t", went)
                elif kind == "session":
                    tmux("switch-client", "-t", went)
                elif b"\033[I" in got or click:
                    try:
                        tmux("last-pane", "-t", pane)
                    except Stop:
                        tmux("select-pane", "-R", "-t", pane)
    finally:
        if waiter:
            waiter.kill()


# gig links: the session's tickets with their links, in a popup (prefix+u): the ticket in the tracker and its merge
# requests. t, m or enter open them in the browser; a click on one opens it too (OSC 8).
def hyperlink(url, text):
    return f"\033]8;;{url}\033\\{text}\033]8;;\033\\"


def merge_requests_of(key, code):
    """The ticket's open and merged merge requests, in any repository (a subtask's to its story, a test package's to
    master), the open ones first: [(link, how it shows)]. One without a link when there is none or GitLab does not
    answer."""
    from urllib.parse import quote
    if code.get("kind") != "gitlab" or not key:
        return [("", "")]
    try:
        found = gitlab(code, f"merge_requests?scope=all&state=all&in=title&search={quote(key)}&per_page=50")
    except Stop:
        return [("", f"{Y}MR ?{O}" + (f" {D}VPN off?{O}" if code.get("vpn") else ""))]
    found = sorted((m for m in found if m["state"] in ("opened", "merged") and of_ticket(key)(m)),
                   key=lambda m: (m["state"] != "opened", m["created_at"]))
    if not found:
        return [("", f"{D}no MR{O}")]
    shown = []
    for m in found:
        repo = m["references"]["full"].split("!", 1)[0].rsplit("/", 1)[-1]
        target = (KEY.match(m["target_branch"]) or [m["target_branch"][:20]])[0]
        color = G if m["state"] == "opened" else C
        shown.append((m["web_url"], f"{color}!{m['iid']} {m['state']}{O}  {D}{repo} → {target}{O}"))
    return shown


def links(args):
    from concurrent.futures import ThreadPoolExecutor
    session = args.session or tmux("display-message", "-p", "#{session_id}")   # a popup: the session it is on
    current = tmux("display-message", "-p", "-t", session, "#{window_id}")
    windows = [(window != current, int(index), worktree) for window, index, worktree in
               ((line.split("\t") + [""])[:3] for line in tmux("list-windows", "-t", session, "-F",   # strip() takes
                                                               "#{window_id}\t#{window_index}\t#{@roger_worktree}").splitlines())]   # an empty last one's tab
    tickets, seen = [], set()
    for _, index, worktree in sorted(windows):   # the current window's first; a review's window shares the ticket's
        folder = os.path.realpath(worktree) if worktree else ""
        if folder and os.path.isdir(folder):
            branch = branch_of(folder) or ""
            key = (KEY.match(branch) or KEY.match(os.path.basename(folder).split("--", 1)[-1]) or [""])[0]
            if (key or folder) not in seen:   # a ticket with worktrees in two repositories: once
                seen.add(key or folder)
                tickets.append((index, branch, key, load_config(folder)))
    if any((config.get("code") or {}).get("kind") == "gitlab" for *_, config in tickets):
        print(f"\n   {D}looking for the merge requests …{O}", flush=True)
    with ThreadPoolExecutor(8) as pool:
        mrs = list(pool.map(lambda t: merge_requests_of(t[2], t[3].get("code") or {}), tickets))
    rows = []
    for (index, branch, key, config), found in zip(tickets, mrs):
        template = (config.get("tracker") or {}).get("ticket_url") or config.get("ticket_url") or ""
        url = template.replace("{key}", key) if template and key else ""
        words = (branch[len(key):] if key and branch.startswith(key) else branch).strip("-").replace("-", " ")
        for n, (mr_url, mr_shown) in enumerate(found):   # a row for each merge request, the ticket on the first
            lead = (f"{D}{index:>2}{O}  {B}{key or '-':<17}{O} {words[:44]:<44}  "
                    + (hyperlink(url, "ticket") if url else f"{D}-     {O}")) if n == 0 else " " * 74   # as wide
            rows.append(f"{url}\t{mr_url}\t{lead}  " + (hyperlink(mr_url, mr_shown) if mr_url else mr_shown))
    fzf(rows, "--with-nth", "3..", "--no-input", "--border-label", " gig · links ",
        "--list-label", " the session's tickets ", "--header", "t ticket · m merge request · ⏎ both · j k move · esc",
        "--bind", "j:down,k:up,q:abort",
        "--bind", "t:execute-silent([ -n {1} ] && open {1})+abort,m:execute-silent([ -n {2} ] && open {2})+abort",
        "--bind", "enter:execute-silent([ -n {1} ] && open {1}; [ -n {2} ] && open {2})+abort")


def main():
    global ASK
    ASK = sys.stdin.isatty() and sys.stdout.isatty()
    prog = os.path.basename(sys.argv[0])   # roger when a Herdr mod calls it: they read "roger: " off its errors
    parser = argparse.ArgumentParser(prog=prog, description="One Claude Code agent per ticket, in a git worktree, in a tmux window or a Herdr space.",
                                     epilog=USAGE.replace("usage: ", "also: "))
    commands = parser.add_subparsers(dest="command", required=True)
    opening = commands.add_parser("open", help="open the ticket's worktree and its agent in a tmux window or a Herdr space")
    opening.add_argument("ticket", help="ticket key (SHOP-1234), one of its branches, or a link with one")
    opening.add_argument("-p", "--project", help="project name or alias (default: the current folder's project, "
                                                 "else the only one with the key's prefix)")
    opening.add_argument("--task", help="the agent's first message instead of the ticket's; with a branch or a link the "
                                        "project must then come from -p or the current folder")
    opening.add_argument("-n", "--dry-run", action="store_true", help="say what would happen; only fetches")
    closer = commands.add_parser("close", help="close the ticket's windows and spaces, delete its worktree and local branch")
    closer.add_argument("ticket", help="ticket key (SHOP-1234), one of its branches, or its worktree's folder")
    closer.add_argument("-p", "--project", help="project name or alias (default: the one with the ticket's worktree)")
    closer.add_argument("-f", "--force", action="store_true", help="close even if uncommitted or unpushed work is lost")
    closer.add_argument("-n", "--dry-run", action="store_true", help="say what would happen, change nothing")
    starter = commands.add_parser("init", help="write the current folder's gig.json, a client's settings, asking step by step")
    starter.add_argument("-y", "--yes", action="store_true", help="take every proposal without asking")
    notifier = commands.add_parser("notify", help="for Claude Code's hooks: the agent's state beside its window's name, "
                                                  "a notification and a bell when it needs you")
    notifier.add_argument("event", choices=["busy", "waiting", "done", "ready", "end"],
                          help="busy (UserPromptSubmit, PostToolUse), waiting (Notification), done (Stop), "
                               "ready (SessionStart), end (SessionEnd)")
    side = commands.add_parser("sidebar", help="the session's windows in a pane on the left: what runs in the sidebar's pane")
    side.add_argument("--follow", metavar="SESSION", help="for tmux's hooks: move the sidebar into the session's window")
    side.add_argument("--toggle", metavar="SESSION", help="show or hide the session's sidebar (prefix+b)")
    linker = commands.add_parser("links", help="the session's tickets with their links: the ticket and its merge request (prefix+u)")
    linker.add_argument("session", nargs="?", help="a tmux session (default: the current one)")
    argv = sys.argv[1:]
    try:
        handlers = {"open": open_ticket, "close": close_ticket, "init": init_client, "notify": notify, "sidebar": sidebar,
                    "links": links}
        if argv[:1] and argv[0] in handlers or argv[:1] and argv[0].startswith("-"):
            args = parser.parse_args(argv)
            if ASK and args.command in ("open", "close"):
                sys.stdout = Pretty(sys.stdout)
            handlers[args.command](args)
        elif argv:
            run_gig(parser, argv)
        elif ASK:
            menus_loop(parser)
        else:
            raise Stop(USAGE)
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except Stop as e:
        sys.stdout.flush()   # the lines so far come first, also through a pipe
        sys.stdout = sys.__stdout__   # Pretty holds back a line without its end: the key prompt has none
        print(f"\n   {R}✗ {e}{O}" if ASK else f"{prog}: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
